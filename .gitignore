# Dependencies & build
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment — keep secrets out of git.
# Public Vite client keys ARE committed in .env.production / .env.development
# because Vercel builds embed them at compile time (no dashboard env required).
# Never commit Stripe secret keys (sk_/whsec_) or the Supabase service role.
.env
.env.local
.env.*.local
.env.e2e

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite / tooling
vite.config.ts.timestamp-*.mjs
supabase/.temp/

# Capacitor generated / flavor builds (not source of truth)
android-customer/
android-driver/
ios-customer/
ios-driver/
capacitor.config.shared.ts.bak
mobile-apks/
store-bundles/
*.aab

# Play upload keys (generate with scripts/setup-play-signing.sh)
mobile-signing/*.jks
mobile-signing/*.keystore
mobile-signing/key.properties
mobile-signing/passwords.txt
mobile-signing/*.pem
# Firebase / FCM (never commit)
mobile-signing/firebase/google-services*.json
mobile-signing/firebase/firebase-service-account.json
mobile-signing/firebase/fcm-server-key.txt
android*/app/google-services.json
native-*/app/google-services.json

# Scratch / one-off SQL (canonical schema lives in supabase/migrations/)
batch_*.sql
*.sql.bak

# Lockfile policy: npm (package-lock.json) is canonical — ignore Bun locks
bun.lock
bun.lockb

# Local load / debug scripts
scripts/load-sim-*.mjs

# Lovable / misc leftovers
.lovable/
new.github

# Local Vercel CLI leftovers (project serves from Vercel)
.vercel/
!plugins/*/dist/
.vercel
.env.local
.env.*.local
