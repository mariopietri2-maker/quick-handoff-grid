+    /**
+     * Play the chime/vibrate repeatedly so K-role store calls and normal offers
+     * are heard more than once (matches web playOfferAlert repeat behaviour).
+     */
+    private fun startAlertBurst(key: String, reps: Int = 6, gapMs: Long = 900L) {
+        if (key == lastOfferAlertKey && alertRepeatJob?.isActive == true) return
+        lastOfferAlertKey = key
+        alertRepeatJob?.cancel()
+        val local = _state.value.settingsLocal
+        if (!local.offerSound && !local.vibration) return
+        val soundId = local.soundId
+        val doSound = local.offerSound
+        val doVibrate = local.vibration
+        alertRepeatJob = viewModelScope.launch {
+            repeat(reps.coerceIn(1, 12)) { i ->
+                if (doSound) playSoundOnce(soundId)
+                if (doVibrate) vibrateOffer()
+                if (i < reps - 1) delay(gapMs)
+            }
+        }
+    }
+
+    private fun stopAlertBurst() {
+        alertRepeatJob?.cancel()
+        alertRepeatJob = null
+        stopMediaPlayer()
+    }
