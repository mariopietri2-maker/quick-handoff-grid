{
  "appId": "com.freshdelivery.customer",
  "appName": "fresh2go",
  "webDir": "dist",
  "server": {
    "url": "https://fresh2go.gr/order",
    "androidScheme": "https",
    "allowNavigation": [
      "https://fresh2go.gr/*",
      "https://www.fresh2go.gr/*",
      "https://quick-handoff-grid-8qu8.vercel.app/*",
      "https://freshdelivery.app/*",
      "https://*.vercel.app/*",
      "https://ojkesspghyqmjmupybva.supabase.co/*",
      "https://*.supabase.co/*",
      "https://api.mapbox.com/*",
      "https://quick-handoff-grid-production.up.railway.app/*"
    ]
  },
  "android": {
    "backgroundColor": "#fff7ec",
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "backgroundColor": "#fff7ec",
      "launchAutoHide": true,
      "launchShowDuration": 400,
      "launchFadeOutDuration": 280
    }
  }
}
