{
  "appId": "com.freshdelivery.customer",
  "appName": "fresh2go",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "allowNavigation": [
      "https://freshdelivery.app/*",
      "https://fresh2go.gr/*",
      "https://www.fresh2go.gr/*",
      "https://ojkesspghyqmjmupybva.supabase.co/*",
      "https://*.supabase.co/*",
      "https://quick-handoff-grid-production.up.railway.app/*",
      "https://fresh-delivery-rho.vercel.app/*",
      "https://api.mapbox.com/*"
    ]
  },
  "android": {
    "path": "android",
    "backgroundColor": "#fff7ec",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "StatusBar": { "style": "DARK", "backgroundColor": "#fff7ec", "overlaysWebView": true },
    "SplashScreen": { "backgroundColor": "#fff7ec", "launchAutoHide": true, "launchShowDuration": 400, "launchFadeOutDuration": 280 },
    "Keyboard": { "resize": "body", "resizeOnFullScreen": true },
    "Geolocation": {},
    "BackgroundGeolocation": {
      "notificationTitle": "fresh2go — τοποθεσία",
      "notificationText": "Ζωντανή παρακολούθηση παραγγελίας"
    },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] }
  }
}