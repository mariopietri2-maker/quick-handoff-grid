# Copy to .env.local / configure in Vercel. Never commit live Stripe secret keys.

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key — use pk_live_… in production (Vercel env override)
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_…

# Mapbox public token (restrict by URL in Mapbox dashboard)
VITE_MAPBOX_TOKEN=pk.…

# Edge / server secrets (Supabase secrets — not Vite):
# STRIPE_LIVE_API_KEY=
# STRIPE_TEST_API_KEY=
# PAYMENTS_LIVE_WEBHOOK_SECRET=
# PAYMENTS_TEST_WEBHOOK_SECRET=
# MAPBOX_PUBLIC_TOKEN=
# CRON_SECRET=
