# Copy to .env.local and fill in. Configure the same keys on Railway for production.
# Never commit real secret keys (service role, Stripe sk_/whsec_).

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Stripe publishable key — use pk_live_… in production (Railway env)
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_replace_me

# Mapbox public token (restrict by URL in the Mapbox dashboard)
VITE_MAPBOX_TOKEN=pk.replace_me

# --- Supabase Edge Function secrets (dashboard, not Vite) ---
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_LIVE_API_KEY=
# STRIPE_TEST_API_KEY=
# PAYMENTS_LIVE_WEBHOOK_SECRET=
# PAYMENTS_TEST_WEBHOOK_SECRET=
# MAPBOX_PUBLIC_TOKEN=
# CRON_SECRET=
