name: Fix customer shell compile + rebuild AAB
on:
  workflow_dispatch:
  push:
    paths:
      - "scripts/fix-customer-shell-compile.py"
      - ".github/workflows/fix-customer-shell-compile.yml"
jobs:
  apply:
    runs-on: ubuntu-latest
    timeout-minutes: 55
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - name: Apply fix
        run: python3 scripts/fix-customer-shell-compile.py
      - name: Commit
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add native-customer/
          if git diff --staged --quiet; then echo no change; else
            git commit -m "fix(customer-native): CartCheckoutScreen @Composable + ProfileTab onOpenPayments"
            git push
          fi
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - name: Build AAB
        run: |
          cd native-customer
          ./gradlew bundleRelease
      - name: Upload AAB
        uses: actions/upload-artifact@v4
        with:
          name: customer-aab
          path: native-customer/app/build/outputs/bundle/release/*.aab
