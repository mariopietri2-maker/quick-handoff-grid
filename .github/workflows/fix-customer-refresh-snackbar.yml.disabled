name: Fix customer refresh snackbar
on:
  workflow_dispatch:
  push:
    paths:
      - "scripts/fix-customer-refresh-snackbar.py"
      - ".github/workflows/fix-customer-refresh-snackbar.yml"
jobs:
  apply:
    runs-on: ubuntu-latest
    timeout-minutes: 55
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - name: Apply fix
        run: python3 scripts/fix-customer-refresh-snackbar.py
      - name: Commit
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add native-customer/app/src/main/java/com/freshdelivery/nativecustomer/ui/CustomerViewModel.kt \
                  native-customer/app/src/main/java/com/freshdelivery/nativecustomer/ui/CustomerShell.kt
          if git diff --staged --quiet; then echo no change; else
            git commit -m "fix(customer-native): no home snackbar on background store/orders refresh fail"
            git push
          fi
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - name: Build APK
        run: |
          cd native-customer
          ./gradlew assembleDebug
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: customer-apk
          path: native-customer/app/build/outputs/apk/debug/*.apk
